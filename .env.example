# --- AIS (ais.usvisa-info.com) account — the one you pay the MRV fee with ---
AIS_EMAIL=you@example.com
AIS_PASSWORD=your-ais-password

# --- Pushover (https://pushover.net) — push notifications to your phone ---
# 1. Install the "Pushover Notifications" iPhone app, create an account in it
#    (email + password, no 2FA), and BUY the $4.99 unlock right away: if the
#    30-day trial lapses, the API keeps reporting success while your phone
#    silently stops showing notifications.
# 2. Log in at pushover.net — your 30-char User Key is at the top of the page.
# 3. "Create an Application/API Token" (name it h1b-watcher) — copy the token.
PUSHOVER_USER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUSHOVER_APP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Booking window ---
# Earliest acceptable date is rolling: today + EARLIEST_OFFSET_DAYS (e.g. on Aug 5 -> Aug 10 onward)
EARLIEST_OFFSET_DAYS=5
LATEST_DATE=2026-08-21

# --- Safety ---
# Keep true until recon + a real poll look right. When true the bot stops right
# before the booking POST and notifies you with exactly what it would have submitted.
TEST_MODE=true

# --- Polling cadence (restart the poller after changing) ---
# Each cycle checks ALL 7 consulates back-to-back, then sleeps
# POLL_BASE_SECONDS + random(0..POLL_JITTER_SECONDS), multiplied by
# NIGHT_MULTIPLIER between 01:00 and 06:00 (1 = no overnight easing).
# ~2,500 requests/day at the defaults — AIS soft-bans on cumulative count,
# and this bot does NOT detect bans; slow down if slots stop appearing.
POLL_BASE_SECONDS=180
POLL_JITTER_SECONDS=120
NIGHT_MULTIPLIER=2

# --- Local dashboard (http://127.0.0.1:<port>, loopback only) ---
DASHBOARD_PORT=8765
