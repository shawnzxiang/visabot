# --- AIS (ais.usvisa-info.com) account — the one you pay the MRV fee with ---
AIS_EMAIL=you@example.com
AIS_PASSWORD=your-ais-password

# --- Gmail sending (create an App Password: Google Account > Security >
#     2-Step Verification > App passwords > "Mail"; paste the 16 chars, no spaces) ---
GMAIL_USER=shawnzxiang@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_TO=shawnzxiang@gmail.com

# --- Booking window ---
# Earliest acceptable date is rolling: today + EARLIEST_OFFSET_DAYS (e.g. on Aug 5 -> Aug 10 onward)
EARLIEST_OFFSET_DAYS=5
LATEST_DATE=2026-08-21

# --- Safety ---
# Keep true until recon + a real poll look right. When true the bot stops right
# before the booking POST and emails you exactly what it would have submitted.
TEST_MODE=true
